# ---------------------------------------------------------------------------
# TaskHub environment — copy to `.env` and fill in the blanks.
# `.env` is git-ignored; this file is the committed template.
# ---------------------------------------------------------------------------

# PostgreSQL. Local dev example (create the db + role first, see README):
#   createdb taskhub && createuser taskhub --pwprompt
DATABASE_URL="postgresql://taskhub:taskhub@localhost:5432/taskhub?schema=public"

# Better Auth — 32+ byte random string. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="replace-me"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Serves two things, and needs a redirect URI for each:
#   sign-in      http://localhost:3000/api/auth/callback/google
#   YouTube link http://localhost:3000/api/integrations/youtube/callback
#
# The YouTube link is the strongest verification in the app: with a worker's
# read-only token we can ask YouTube whether that specific worker subscribes to
# a channel, so subscribe campaigns need nothing connected on the buyer side and
# clear within minutes. Enable "YouTube Data API v3" on the project and request
# the .../auth/youtube.readonly scope. That scope needs Google verification
# before people outside your test users can grant it.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# A plain API key with YouTube Data API v3 enabled — no OAuth, no consent
# screen, no Google verification. It buys two things:
#   1. turns a pasted youtube.com/@handle into a channel id when a buyer
#      creates a campaign (a /channel/UC… link resolves without it);
#   2. the profile-code check: a worker who cannot do the full OAuth link puts
#      a one-time code in their channel's About description and the cron reads
#      it back, so nobody is stuck self-declared forever.
# Set this even if GOOGLE_CLIENT_SECRET above is still empty — it is the
# cheapest way to get workers verified.
YOUTUBE_API_KEY=""

# Auth codes. While AUTH_STATIC_OTP is set, every verification / reset code is
# exactly this value and nothing has to be emailed. Set it to "" for random
# 6-digit codes (and turn MAIL_ENABLED on so they can actually be delivered).
AUTH_STATIC_OTP="123456"

# Outgoing mail is OFF unless this is exactly "true". While off, every message
# — codes included — is printed to the server console instead of being sent.
MAIL_ENABLED=false

# SMTP for transactional email (verification codes, password reset, contact form).
# For Gmail: enable 2FA, then create an App Password (Google Account -> Security)
# and paste the 16 chars with no spaces into MAIL_PASSWORD.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps          # smtps => implicit TLS (port 465). Use "smtp" for STARTTLS (587).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME="TaskHub"
CONTACT_RECEIVER=""

# Facebook app (auto-verified follow campaigns). Create an app at
# https://developers.facebook.com -> Facebook Login for Business, and add
# https://<your-host>/api/integrations/facebook/callback as a valid OAuth
# redirect URI — it serves both flows (buyer connects a page, worker links their
# own profile). Permissions: pages_show_list + pages_read_engagement for pages,
# instagram_basic + instagram_manage_insights to reach the Instagram business
# account behind a page, and public_profile + user_link for worker profiles.
# All but public_profile need App Review before people outside your app admins
# can use them. Leave empty to keep Facebook and Instagram campaigns on manual
# review (YouTube is independent of this — it uses the Google credentials).
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_GRAPH_VERSION="v21.0"

# Instagram app (worker account linking) — https://developers.facebook.com,
# an app with the "Instagram" product added. Valid OAuth redirect URI:
# https://<your-host>/api/integrations/instagram/callback
#
# Read the ceiling before wiring this up. Instagram exposes NO endpoint, on any
# token, that says whether one person follows another — Basic Display was shut
# down in December 2024 and nothing replaced it. So linking here only confirms
# *which* account a worker owns; the follow itself is settled against the
# follower count of the buyer's Instagram business account, read through the
# Facebook page it is attached to (so FACEBOOK_APP_ID above covers that half).
#
# It is also Business/Creator only: a worker on a personal account cannot
# complete this flow, and falls back to claiming their handle in the panel.
# Leave empty to offer only the claim-your-handle path.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

# Shared secret for the schedulers:
#   POST /api/cron/verify   — YouTube subscription checks, Facebook and
#                             Instagram follower checks, and hold release
#                             (every few minutes)
#   POST /api/cron/release  — hold release only
CRON_SECRET="replace-me"

# Super admin created by `npm run db:seed`. Change the password before deploying.
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_EMAIL="admin@taskhub.com.bd"
SEED_ADMIN_PASSWORD="Password123!"

# --- Realtime + push -----------------------------------------------------
# Socket.IO needs no configuration: `npm run dev` / `npm start` boot server.ts,
# which serves Next and the socket on the same port. Check it is live at
# GET /api/realtime/status (admin only).

# Firebase Cloud Messaging — device push. Leave every value empty to keep push
# off: in-app notifications and the live socket keep working without it.
#
# Server half — Firebase console → Project settings → Service accounts →
# "Generate new private key". The key is one line; keep the \n escapes.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Browser half — Project settings → General → "Your apps" → Web app config,
# and Cloud Messaging → Web Push certificates for the VAPID key pair.
# These are public by design (they ship in the bundle).
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# --- Image uploads (ImageKit) -------------------------------------------
# https://imagekit.io → Developer options → API keys. Leave empty to hide the
# "upload a photo" button; nothing else changes.
#
# The browser uploads straight to ImageKit with a short-lived signature minted
# by GET /api/uploads/imagekit, so the private key never leaves the server and
# files never pass through this app.
#
# In the ImageKit dashboard, restrict uploads to images (Settings → Media
# library → file type restrictions) — a signed grant is scoped to the folder,
# not to the file type.
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT=""
