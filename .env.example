# ---------------------------------------------------------------------------
# TaskHub environment — copy to `.env` and fill in the blanks.
# `.env` is git-ignored; this file is the committed template.
# ---------------------------------------------------------------------------

# PostgreSQL. Local dev example (create the db + role first, see README):
#   createdb taskhub && createuser taskhub --pwprompt
DATABASE_URL="postgresql://taskhub:taskhub@localhost:5432/taskhub?schema=public"

# Better Auth — 32+ byte random string. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="replace-me"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Auth codes. While AUTH_STATIC_OTP is set, every verification / reset code is
# exactly this value and nothing has to be emailed. Set it to "" for random
# 6-digit codes (and turn MAIL_ENABLED on so they can actually be delivered).
AUTH_STATIC_OTP="123456"

# Outgoing mail is OFF unless this is exactly "true". While off, every message
# — codes included — is printed to the server console instead of being sent.
MAIL_ENABLED=false

# SMTP for transactional email (verification codes, password reset, contact form).
# For Gmail: enable 2FA, then create an App Password (Google Account -> Security)
# and paste the 16 chars with no spaces into MAIL_PASSWORD.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps          # smtps => implicit TLS (port 465). Use "smtp" for STARTTLS (587).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME="TaskHub"
CONTACT_RECEIVER=""

# Facebook app (auto-verified follow campaigns). Create an app at
# https://developers.facebook.com -> Facebook Login for Business, and add
# https://<your-host>/api/integrations/facebook/callback as a valid OAuth
# redirect URI — it serves both flows (buyer connects a page, worker links their
# own profile). Permissions: pages_show_list + pages_read_engagement for pages,
# public_profile + user_link for worker profiles. All but public_profile need
# App Review before people outside your app admins can use them.
# Leave empty to keep every campaign on manual review.
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_GRAPH_VERSION="v21.0"

# Shared secret for the schedulers:
#   POST /api/cron/verify   — follower check + hold release (every few minutes)
#   POST /api/cron/release  — hold release only
CRON_SECRET="replace-me"

# Super admin created by `npm run db:seed`. Change the password before deploying.
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_EMAIL="admin@taskhub.com.bd"
SEED_ADMIN_PASSWORD="Password123!"
